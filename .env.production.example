ENVIRONMENT=production
DOMAIN=https://webownik.example.pl
CORS_ORIGINS=https://webownik.example.pl
ALLOWED_HOSTS=webownik.example.pl,api,127.0.0.1
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Internal addresses on the private Supabase Docker network.
DATABASE_URL=postgresql://webownik_app:CHANGE_ME@db:5432/postgres
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
SUPABASE_SECRET_KEY=CHANGE_ME

# Cloudflare Turnstile server-side secret. Never expose it in frontend code.
TURNSTILE_SECRET_KEY=CHANGE_ME
VITE_TURNSTILE_SITE_KEY=CHANGE_ME

GITHUB_REPOSITORY=Git-Jacob-bit/webownik_again
# Docelowo zastąp tokenem instalacyjnym GitHub App.
GITHUB_TOKEN=CHANGE_ME

# Bind only to loopback when cloudflared runs on the TrueNAS host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5000
SUPABASE_NETWORK=supabase_default
CLOUDFLARE_NETWORK=cloudflare_default
