server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 25m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass http://webownik-api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }

    # Public callback required by confirmation and password-recovery links.
    # Only /verify is exposed; every other Auth endpoint is reachable only through FastAPI.
    location = /supabase-auth/verify {
        limit_except GET { deny all; }
        proxy_pass http://kong:8000/auth/v1/verify;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp)$ {
        expires 7d;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
